 namespace web_package {
 
@@ -50,8 +51,9 @@ EcdsaP256SHA256Signature::EcdsaP256SHA256Signature(std::vector<uint8_t> bytes)
 [[nodiscard]] bool EcdsaP256SHA256Signature::Verify(
